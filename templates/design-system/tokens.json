{
  "$description": "디자인 토큰 시작 파일 (W3C DTCG 형식). 기본값 층 → 의미 층. 운영 사이트 · 브랜드 값으로 바꾸고 python -I scripts/design_tokens.py check <spec-kit>",
  "palette": {
    "gray": {
      "0": { "$type": "color", "$value": "#FFFFFF" },
      "50": { "$type": "color", "$value": "#F7F8FA" },
      "100": { "$type": "color", "$value": "#EEF0F3" },
      "200": { "$type": "color", "$value": "#DDE1E7" },
      "500": { "$type": "color", "$value": "#6B7280" },
      "700": { "$type": "color", "$value": "#374151" },
      "900": { "$type": "color", "$value": "#111827" }
    },
    "blue": { "600": { "$type": "color", "$value": "#0B63CE" }, "700": { "$type": "color", "$value": "#0A52AB" }, "50": { "$type": "color", "$value": "#EAF2FD" } },
    "green": { "700": { "$type": "color", "$value": "#11743F" } },
    "amber": { "700": { "$type": "color", "$value": "#8A5300" } },
    "red": { "600": { "$type": "color", "$value": "#C8281E" } }
  },
  "color": {
    "text": { "$type": "color", "$value": "{palette.gray.900}", "$description": "본문" },
    "text-muted": { "$type": "color", "$value": "{palette.gray.500}", "$description": "보조 글자" },
    "surface": { "$type": "color", "$value": "{palette.gray.0}", "$description": "카드 · 입력 바탕" },
    "canvas": { "$type": "color", "$value": "{palette.gray.50}", "$description": "화면 바탕" },
    "border": { "$type": "color", "$value": "{palette.gray.200}" },
    "primary": { "$type": "color", "$value": "{palette.blue.600}", "$description": "주 버튼 · 선택 메뉴" },
    "primary-hover": { "$type": "color", "$value": "{palette.blue.700}" },
    "primary-soft": { "$type": "color", "$value": "{palette.blue.50}" },
    "on-primary": { "$type": "color", "$value": "{palette.gray.0}" },
    "success": { "$type": "color", "$value": "{palette.green.700}" },
    "warning": { "$type": "color", "$value": "{palette.amber.700}" },
    "danger": { "$type": "color", "$value": "{palette.red.600}" }
  },
  "font": {
    "family": { "$type": "fontFamily", "$value": ["Pretendard", "Apple SD Gothic Neo", "Malgun Gothic", "sans-serif"] },
    "body": { "$type": "typography", "$value": { "fontFamily": "inherit", "fontSize": "14px", "fontWeight": 400, "lineHeight": "1.5" } },
    "title": { "$type": "typography", "$value": { "fontFamily": "inherit", "fontSize": "20px", "fontWeight": 700, "lineHeight": "1.35" } }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" }, "2": { "$type": "dimension", "$value": "8px" }, "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" }, "6": { "$type": "dimension", "$value": "24px" }, "8": { "$type": "dimension", "$value": "32px" }
  },
  "radius": { "sm": { "$type": "dimension", "$value": "6px" }, "md": { "$type": "dimension", "$value": "8px" }, "lg": { "$type": "dimension", "$value": "12px" } },
  "shadow": {
    "card": { "$type": "shadow", "$value": { "offsetX": "0", "offsetY": "1px", "blur": "3px", "spread": "0", "color": "rgba(17,24,39,.06)" } },
    "overlay": { "$type": "shadow", "$value": { "offsetX": "0", "offsetY": "12px", "blur": "32px", "spread": "0", "color": "rgba(17,24,39,.18)" } }
  },
  "$extensions": {
    "pairs": [
      ["color.text", "color.surface", 4.5], ["color.text", "color.canvas", 4.5], ["color.text-muted", "color.surface", 4.5],
      ["color.on-primary", "color.primary", 4.5], ["color.primary", "color.surface", 4.5],
      ["color.success", "color.surface", 4.5], ["color.warning", "color.surface", 4.5], ["color.danger", "color.surface", 4.5],
      ["color.border", "color.surface", 1.2]
    ]
  }
}
