  }
 },
 "font": {
  "family": {
   "$type": "fontFamily",
   "$value": [
    "Overpass",
    "Malgun Gothic",
    "Apple SD Gothic Neo",
    "sans-serif"
   ]
  },
  "body": {
   "$type": "typography",
   "$value": {
    "fontFamily": "inherit",
    "fontSize": "14px",
    "fontWeight": 400,
    "lineHeight": "1.5"
   }
  },
  "title": {
   "$type": "typography",
   "$value": {
    "fontFamily": "inherit",
    "fontSize": "20px",
    "fontWeight": 700,
    "lineHeight": "1.35"
   }
  }
 },
