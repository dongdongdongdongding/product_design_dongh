   "$value": "16px"
  },
  "6": {
   "$type": "dimension",
   "$value": "24px"
  },
  "8": {
   "$type": "dimension",
   "$value": "32px"
  }
 },
 "radius": {
  "sm": {
   "$type": "dimension",
   "$value": "3px",
   "$description": "버튼 · 입력 (배포 사이트)"
  },
  "md": {
   "$type": "dimension",
   "$value": "4px",
   "$description": "카드"
  }
 },
 "shadow": {
  "card": {
   "$type": "shadow",
   "$value": {
    "offsetX": "0",
    "offsetY": "1px",
    "blur": "3px",
    "spread": "0",
    "color": "rgba(17,24,39,.06)"
   }
  },
  "overlay": {
   "$type": "shadow",
   "$value": {
    "offsetX": "0",
    "offsetY": "12px",
    "blur": "32px",
    "spread": "0",
    "color": "rgba(17,24,39,.18)"
   }
  }
 },
 "$extensions": {
  "pairs": [
   [
    "color.text",
    "color.surface",
    4.5
   ],
   [
    "color.text",
    "color.canvas",
    4.5
   ],
   [
    "color.text-muted",
    "color.surface",
    4.5
   ],
   [
    "color.on-primary",
    "color.primary",
    4.5
   ],
   [
    "color.primary",
    "color.surface",
    4.5
   ],
   [
    "color.success",
    "color.surface",
    4.5
   ],
   [
    "color.warning",
    "color.surface",
    4.5
   ],
   [
    "color.danger",
    "color.surface",
    4.5
   ],
   [
    "color.border",
    "color.surface",
    1.2
   ]
  ]
 }
